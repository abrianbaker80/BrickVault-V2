[Unit]
Description=Schedule the BrickVault V2 encrypted backup

[Timer]
OnCalendar=*-*-* 02:15:00 America/Chicago
# Central local time skips 02:15 at the annual spring clock change.
OnCalendar=Sun *-03-08..14 03:15:00 America/Chicago
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
