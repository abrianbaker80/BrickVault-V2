{
  "openapi": "3.1.0",
  "info": {
    "title": "BrickVault Foundation API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/session": {
      "get": {
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "signIn",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "basic": []
          }
        ]
      },
      "delete": {
        "operationId": "signOut",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "default": {
            "description": "Application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspace": {
      "get": {
        "operationId": "getWorkspace",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "default": {
            "description": "Application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog": {
      "post": {
        "operationId": "saveCatalog",
        "parameters": [
          {
            "name": "X-Workspace-Id",
            "in": "header",
            "required": true,
            "description": "The authenticated workspaceId captured when the operator prepared the command. Use that same value for every retry. A missing or mismatched workspace returns 409 workspace_mismatch.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "default": {
            "description": "Application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/locations": {
      "post": {
        "operationId": "saveLocation",
        "parameters": [
          {
            "name": "X-Workspace-Id",
            "in": "header",
            "required": true,
            "description": "The authenticated workspaceId captured when the operator prepared the command. Use that same value for every retry. A missing or mismatched workspace returns 409 workspace_mismatch.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocationCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "default": {
            "description": "Application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/diagnostics": {
      "get": {
        "operationId": "workerDiagnostics",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/diagnostics/{correlationId}": {
      "get": {
        "operationId": "commandDiagnostic",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Diagnostic"
                }
              }
            }
          },
          "default": {
            "description": "Application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/export": {
      "get": {
        "operationId": "exportReference",
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "reference"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Export"
                }
              }
            }
          },
          "default": {
            "description": "Application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/contract": {
      "get": {
        "operationId": "getContract",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 contract",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogCommand": {
        "type": "object",
        "properties": {
          "commandId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRevision": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "itemType": {
            "type": "string",
            "enum": [
              "part",
              "set",
              "minifigure",
              "book",
              "gear",
              "instruction",
              "original-box",
              "catalog"
            ]
          },
          "itemNumber": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          "variant": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1
          },
          "colorId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "colorState": {
            "type": "string",
            "enum": [
              "known",
              "unknown",
              "not-applicable"
            ]
          },
          "condition": {
            "type": "string",
            "enum": [
              "new",
              "used",
              "unknown"
            ]
          },
          "completeness": {
            "type": "string",
            "enum": [
              "complete",
              "incomplete",
              "unknown",
              "not-applicable"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "license": {
            "type": "string",
            "enum": [
              "operator-owned",
              "permitted",
              "unknown",
              "restricted"
            ]
          },
          "mapping": {
            "type": "string",
            "enum": [
              "confirmed",
              "ambiguous",
              "unmapped"
            ]
          }
        },
        "required": [
          "commandId",
          "expectedRevision",
          "itemType",
          "itemNumber",
          "variant",
          "name",
          "colorId",
          "colorState",
          "condition",
          "completeness",
          "source",
          "license",
          "mapping"
        ],
        "additionalProperties": false
      },
      "LocationCommand": {
        "type": "object",
        "properties": {
          "commandId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRevision": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,47}$"
          },
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1
          }
        },
        "required": [
          "commandId",
          "expectedRevision",
          "code",
          "name"
        ],
        "additionalProperties": false
      },
      "Receipt": {
        "type": "object",
        "properties": {
          "commandId": {
            "type": "string",
            "format": "uuid"
          },
          "entityId": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "catalog",
              "location"
            ]
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "commandId",
          "entityId",
          "revision",
          "kind",
          "correlationId"
        ],
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "properties": {
          "actor": {
            "type": "string",
            "enum": [
              "operator"
            ]
          },
          "csrfToken": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid",
            "description": "Stable identity of the authenticated workspace, preserved through restore."
          }
        },
        "required": [
          "actor",
          "csrfToken",
          "workspaceId"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "correlationId"
        ],
        "additionalProperties": false
      },
      "CatalogRow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "itemType": {
            "type": "string",
            "enum": [
              "part",
              "set",
              "minifigure",
              "book",
              "gear",
              "instruction",
              "original-box",
              "catalog"
            ]
          },
          "itemNumber": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          "variant": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1
          },
          "colorId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "colorState": {
            "type": "string",
            "enum": [
              "known",
              "unknown",
              "not-applicable"
            ]
          },
          "condition": {
            "type": "string",
            "enum": [
              "new",
              "used",
              "unknown"
            ]
          },
          "completeness": {
            "type": "string",
            "enum": [
              "complete",
              "incomplete",
              "unknown",
              "not-applicable"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "license": {
            "type": "string",
            "enum": [
              "operator-owned",
              "permitted",
              "unknown",
              "restricted"
            ]
          },
          "mapping": {
            "type": "string",
            "enum": [
              "confirmed",
              "ambiguous",
              "unmapped"
            ]
          },
          "integrationEligible": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "revision",
          "itemType",
          "itemNumber",
          "variant",
          "name",
          "colorId",
          "colorState",
          "condition",
          "completeness",
          "source",
          "license",
          "mapping",
          "integrationEligible"
        ],
        "additionalProperties": false
      },
      "LocationRow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "code": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,47}$"
          },
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1
          }
        },
        "required": [
          "id",
          "revision",
          "code",
          "name"
        ],
        "additionalProperties": false
      },
      "AuditRow": {
        "type": "object",
        "properties": {
          "commandId": {
            "type": "string",
            "format": "uuid"
          },
          "entityId": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "catalog",
              "location"
            ]
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "actor": {
            "type": "string",
            "enum": [
              "operator"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "commandId",
          "entityId",
          "revision",
          "kind",
          "correlationId",
          "actor",
          "occurredAt"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "workerState": {
            "type": "string",
            "enum": [
              "healthy",
              "stale",
              "unseen"
            ]
          },
          "lastHeartbeat": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "pendingJobs": {
            "type": "integer",
            "format": "int32"
          },
          "completedJobs": {
            "type": "integer",
            "format": "int32"
          },
          "blockedJobs": {
            "type": "integer",
            "format": "int32"
          },
          "schemaVersion": {
            "type": "integer",
            "format": "int32"
          },
          "apiVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          }
        },
        "required": [
          "workerState",
          "lastHeartbeat",
          "pendingJobs",
          "completedJobs",
          "blockedJobs",
          "schemaVersion",
          "apiVersion"
        ],
        "additionalProperties": false
      },
      "Diagnostic": {
        "type": "object",
        "properties": {
          "commandId": {
            "type": "string",
            "format": "uuid"
          },
          "entityId": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "catalog",
              "location"
            ]
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "jobState": {
            "type": "string",
            "enum": [
              "pending",
              "done",
              "blocked"
            ]
          },
          "payloadVersion": {
            "type": "integer",
            "format": "int32"
          },
          "processedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "commandId",
          "entityId",
          "revision",
          "kind",
          "correlationId",
          "jobState",
          "payloadVersion",
          "processedAt"
        ],
        "additionalProperties": false
      },
      "Export": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "foundation-reference"
            ]
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "complete": {
            "type": "boolean"
          },
          "catalog": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogRow"
            }
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocationRow"
            }
          }
        },
        "required": [
          "scope",
          "asOf",
          "complete",
          "catalog",
          "locations"
        ],
        "additionalProperties": false
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "foundation-reference"
            ]
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "complete": {
            "type": "boolean"
          },
          "catalog": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogRow"
            }
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocationRow"
            }
          },
          "audit": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditRow"
            }
          },
          "health": {
            "$ref": "#/components/schemas/Health"
          }
        },
        "required": [
          "scope",
          "asOf",
          "complete",
          "catalog",
          "locations",
          "audit",
          "health"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "basic": {
        "type": "http",
        "scheme": "basic"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-bv_session"
      }
    }
  },
  "security": [
    {
      "session": []
    }
  ]
}
