{
  "name": "brickvault-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "generate": "openapi-typescript ../BrickVault.Api/openapi.v1.json -o src/schema.d.ts && node tools/validators.mjs",
    "check": "npm run generate && vue-tsc --noEmit",
    "build": "npm run check && vite build",
    "dev": "npm run generate && vite build --mode development --watch",
    "test": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "lucide-static": "1.77.0",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
